{
	"files": {
		"includes": ["src/**/*", "test/**/*", "e2e/**/*", "playwright.config.ts"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"linter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		{
			"includes": ["test/**/*", "**/*/*.test.ts*"],
			"linter": {
				"rules": {
					"a11y": "off",
					"performance": {
						"noImgElement": "off"
					}
				}
			},
			"assist": {
				"actions": {
					"source": {
						"organizeImports": {
							"level": "on",
							"options": {
								/**
								 *  An override replaces the whole groups list, so this is a copy of the main list below
								 *  with test libraries as the first group. Keep the two in step.
								 */
								"groups": [
									{
										"type": false,
										"source": [
											"vitest",
											"vitest/**",
											"@vitest/*",
											"@testing-library/*"
										]
									},
									{
										"type": true,
										"source": [
											"vitest",
											"vitest/**",
											"@vitest/*",
											"@testing-library/*"
										]
									},
									":BLANK_LINE:",
									"server-only",
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["node:*"]
									},
									{
										"type": true,
										"source": ["node:*"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["next", "next/**", "react", "react-dom"]
									},
									{
										"type": true,
										"source": ["next", "next/**", "react", "react-dom"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["@mantine/*", "@tabler/*"]
									},
									{
										"type": true,
										"source": ["@mantine/*", "@tabler/*"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["@schedule-x/*", "temporal-polyfill/global"]
									},
									{
										"type": true,
										"source": ["@schedule-x/*", "temporal-polyfill/global"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["@*/**", "!@/**"]
									},
									{
										"type": true,
										"source": ["@*/**", "!@/**"]
									},
									":BLANK_LINE:",
									":PACKAGE:",
									":BLANK_LINE:",
									":ALIAS:",
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["./*", "!./*.css"]
									},
									{
										"type": true,
										"source": ["./*", "!./*.css"]
									},
									{
										"source": ["./*.css"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["../*"]
									},
									{
										"type": true,
										"source": ["../*"]
									}
								]
							}
						}
					}
				}
			}
		},
		/**
		 *  Import bans from docs/e2e_tests.md. Biome applies every override that matches a file, and a later
		 *  override's options for a rule replace an earlier one's, so each file set below lists every ban that
		 *  applies to it and no two of them match the same file.
		 */
		{
			"includes": ["src/**/*", "!**/*/*.test.ts*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"test/**/*",
				"**/*/*.test.ts*",
				"!test/auth.ts",
				"!test/factories/**/*",
				"!e2e/**/*"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["test/auth.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["test/factories/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
									"@/_actions": "Factories write only through @/_models and the test-only auth instance in test/auth.ts. See docs/e2e_tests.md.",
									"@/_auth": "Factories write only through @/_models and the test-only auth instance in test/auth.ts. See docs/e2e_tests.md.",
									"server-only": "Factories write only through @/_models and the test-only auth instance in test/auth.ts. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_actions/**", "@/_auth/**"],
										"message": "Factories write only through @/_models and the test-only auth instance in test/auth.ts. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/_fixtures/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"mongoose": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"mongodb": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"@/_models": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_models/**"],
										"message": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md."
									},
									{
										"group": ["#factories/*", "!#factories/connection"],
										"message": "Fixtures only open and close connections. Specs create their own data with the factories. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/**/*", "!e2e/_fixtures/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Specs import test and expect from e2e/_fixtures/, not @playwright/test. See docs/e2e_tests.md.",
									"mongoose": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"mongodb": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"@/_models": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_models/**"],
										"message": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.module.css"],
			"linter": {
				"rules": {
					"correctness": {
						/**
						 *  biome correctly identifies :global and :local as valid CSS module pseudo-classes but the
						 *  LSP (used by the IDE) does not
						 */
						"noUnknownPseudoClass": {
							"level": "error",
							"options": {
								"ignore": ["global", "local"]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							"server-only",
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["node:*"]
							},
							{
								"type": true,
								"source": ["node:*"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["next", "next/**", "react", "react-dom"]
							},
							{
								"type": true,
								"source": ["next", "next/**", "react", "react-dom"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["@mantine/*", "@tabler/*"]
							},
							{
								"type": true,
								"source": ["@mantine/*", "@tabler/*"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["@schedule-x/*", "temporal-polyfill/global"]
							},
							{
								"type": true,
								"source": ["@schedule-x/*", "temporal-polyfill/global"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["@*/**", "!@/**"]
							},
							{
								"type": true,
								"source": ["@*/**", "!@/**"]
							},
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["./*", "!./*.css"]
							},
							{
								"type": true,
								"source": ["./*", "!./*.css"]
							},
							{
								"source": ["./*.css"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["../*"]
							},
							{
								"type": true,
								"source": ["../*"]
							}
						]
					}
				}
			}
		}
	}
}
