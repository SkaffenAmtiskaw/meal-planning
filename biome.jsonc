{
	"files": {
		"includes": [
			"src/**/*",
			"test/**/*",
			"e2e/**/*",
			"seed/**/*",
			"scripts/**/*.ts",
			"playwright.config.ts",
			// A worktree nested here is its own project with its own biome.jsonc.
			"!!.claude/worktrees"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"linter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		/**
		 *  tsconfig.json allows imports with a .ts extension, because node can't find a file without its extension. So
		 *  only the files that plain node runs may use one: the scripts, and the E2E servers playwright.config.ts starts.
		 */
		{
			"includes": [
				"**",
				"!scripts/**",
				"!e2e/_fixtures/memoryServer.ts",
				"!e2e/_fixtures/fakeResend.ts"
			],
			"plugins": ["./biome-plugins/noTsExtensionImports.grit"]
		},
		{
			"includes": ["test/**/*", "**/*/*.test.ts*"],
			"linter": {
				"rules": {
					"a11y": "off",
					"performance": {
						"noImgElement": "off"
					}
				}
			},
			"assist": {
				"actions": {
					"source": {
						"organizeImports": {
							"level": "on",
							"options": {
								/**
								 *  An override replaces the whole groups list, so this is a copy of the main list below
								 *  with test libraries as the first group. Keep the two in step.
								 */
								"groups": [
									{
										"type": false,
										"source": [
											"vitest",
											"vitest/**",
											"@vitest/*",
											"@testing-library/*"
										]
									},
									{
										"type": true,
										"source": [
											"vitest",
											"vitest/**",
											"@vitest/*",
											"@testing-library/*"
										]
									},
									":BLANK_LINE:",
									"server-only",
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["node:*"]
									},
									{
										"type": true,
										"source": ["node:*"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["next", "next/**", "react", "react-dom"]
									},
									{
										"type": true,
										"source": ["next", "next/**", "react", "react-dom"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["@mantine/*", "@tabler/*"]
									},
									{
										"type": true,
										"source": ["@mantine/*", "@tabler/*"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["@*/**", "!@/**"]
									},
									{
										"type": true,
										"source": ["@*/**", "!@/**"]
									},
									":BLANK_LINE:",
									":PACKAGE:",
									":BLANK_LINE:",
									":ALIAS:",
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["./*", "!./*.css"]
									},
									{
										"type": true,
										"source": ["./*", "!./*.css"]
									},
									{
										"source": ["./*.css"]
									},
									":BLANK_LINE:",
									{
										"type": false,
										"source": ["../*"]
									},
									{
										"type": true,
										"source": ["../*"]
									}
								]
							}
						}
					}
				}
			}
		},
		/**
		 *  Import bans from docs/e2e_tests.md and docs/project_conventions.md, "Stored Data". Biome applies every
		 *  override that matches a file, and a later override's options for a rule replace an earlier one's, so each
		 *  file set below lists every ban that applies to it and no two of them match the same file.
		 *
		 *  Only the data module in src/_models/database/ and the release tasks import mongodb. The raw database
		 *  handle (rawDatabase, and openDatabase for another URI) is used only by better-auth's two instances,
		 *  seed/emptyWorktreeDatabase.ts, scripts/restoreTest.ts and the release tasks, which each have a file set of
		 *  their own below. The release tasks are in no file set, because no ban applies to them.
		 */
		{
			"includes": [
				"src/**/*",
				"!**/*/*.test.ts*",
				"!src/_models/database/**/*",
				"!src/_auth/auth.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
									"mongodb": "Code outside the data module in src/_models/database/ doesn't import mongodb. Read and write through its collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
								},
								"patterns": [
									{
										"group": [
											"**/_models/database/connection",
											"**/_models/database/connection.ts"
										],
										"importNamePattern": "rawDatabase",
										"message": "The raw database handle is only for code that works below the schemas. Read and write through the data module's collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
									},
									{
										"group": [
											"**/_models/database/openDatabase",
											"**/_models/database/openDatabase.ts"
										],
										"message": "The raw database handle is only for code that works below the schemas. Read and write through the data module's collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/_models/database/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/_auth/auth.ts", "seed/emptyWorktreeDatabase.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
									"mongodb": "Code outside the data module in src/_models/database/ doesn't import mongodb. Use its raw database handle. See docs/project_conventions.md, \"Stored Data\"."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"test/**/*",
				"seed/**/*",
				"**/*/*.test.ts*",
				"!test/auth.ts",
				"!test/factories/**/*",
				"!e2e/**/*",
				"!src/_models/database/**/*",
				"!seed/emptyWorktreeDatabase.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
									"mongodb": "Code outside the data module in src/_models/database/ doesn't import mongodb. Read and write through its collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
								},
								"patterns": [
									{
										"group": [
											"**/_models/database/connection",
											"**/_models/database/connection.ts"
										],
										"importNamePattern": "rawDatabase",
										"message": "The raw database handle is only for code that works below the schemas. Read and write through the data module's collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
									},
									{
										"group": [
											"**/_models/database/openDatabase",
											"**/_models/database/openDatabase.ts"
										],
										"message": "The raw database handle is only for code that works below the schemas. Read and write through the data module's collection wrappers. See docs/project_conventions.md, \"Stored Data\"."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["test/auth.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"mongodb": "Code outside the data module in src/_models/database/ doesn't import mongodb. Use its raw database handle. See docs/project_conventions.md, \"Stored Data\"."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["test/factories/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Playwright code lives in e2e/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
									"@/_actions": "Factories write through the data module's collection wrappers in @/_models/database, and reach better-auth only through test/auth.ts and @/_auth/users. See docs/e2e_tests.md.",
									"@/_auth": "Factories write through the data module's collection wrappers in @/_models/database, and reach better-auth only through test/auth.ts and @/_auth/users. See docs/e2e_tests.md.",
									"server-only": "Factories write through the data module's collection wrappers in @/_models/database, and reach better-auth only through test/auth.ts and @/_auth/users. See docs/e2e_tests.md.",
									"mongodb": "Factories write through the data module's collection wrappers in @/_models/database. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_actions/**", "@/_auth/**", "!@/_auth/users"],
										"message": "Factories write through the data module's collection wrappers in @/_models/database, and reach better-auth only through test/auth.ts and @/_auth/users. See docs/e2e_tests.md."
									},
									{
										"group": [
											"**/_models/database/connection",
											"**/_models/database/connection.ts"
										],
										"importNamePattern": "rawDatabase",
										"message": "Factories write through the data module's collection wrappers in @/_models/database. See docs/e2e_tests.md."
									},
									{
										"group": [
											"**/_models/database/openDatabase",
											"**/_models/database/openDatabase.ts"
										],
										"message": "Factories write through the data module's collection wrappers in @/_models/database. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/_fixtures/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"mongodb": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"@/_models": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_models/**"],
										"message": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md."
									},
									{
										"group": ["#factories/*", "!#factories/connection"],
										"message": "Fixtures only open and close connections. Specs create their own data with the factories. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["e2e/**/*", "!e2e/_fixtures/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Specs import test and expect from e2e/_fixtures/, not @playwright/test. See docs/e2e_tests.md.",
									"mongodb": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"@/_models": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md.",
									"better-auth/plugins": {
										"message": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md.",
										"importNames": ["testUtils"]
									},
									"better-auth/test": "testUtils is used only in test/auth.ts, the test-only auth instance. See docs/e2e_tests.md."
								},
								"patterns": [
									{
										"group": ["@/_models/**"],
										"message": "E2E code creates data only through the factories in test/factories/. See docs/e2e_tests.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"scripts/**/*.ts",
				"playwright.config.ts",
				"!scripts/release-tasks/**/*",
				"!scripts/restoreTest.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"mongodb": "Only the data module in src/_models/database/ and the release tasks import mongodb. See docs/project_conventions.md, \"Stored Data\"."
								},
								"patterns": [
									{
										"group": [
											"**/_models/database/connection",
											"**/_models/database/connection.ts"
										],
										"importNamePattern": "rawDatabase",
										"message": "The raw database handle is only for code that works below the schemas. See docs/project_conventions.md, \"Stored Data\"."
									},
									{
										"group": [
											"**/_models/database/openDatabase",
											"**/_models/database/openDatabase.ts"
										],
										"message": "The raw database handle is only for code that works below the schemas. See docs/project_conventions.md, \"Stored Data\"."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["scripts/restoreTest.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"mongodb": "Only the data module in src/_models/database/ and the release tasks import mongodb. Use the module's openDatabase. See docs/project_conventions.md, \"Stored Data\"."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.module.css"],
			"linter": {
				"rules": {
					"correctness": {
						/**
						 *  biome correctly identifies :global and :local as valid CSS module pseudo-classes but the
						 *  LSP (used by the IDE) does not
						 */
						"noUnknownPseudoClass": {
							"level": "error",
							"options": {
								"ignore": ["global", "local"]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							"server-only",
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["node:*"]
							},
							{
								"type": true,
								"source": ["node:*"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["next", "next/**", "react", "react-dom"]
							},
							{
								"type": true,
								"source": ["next", "next/**", "react", "react-dom"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["@mantine/*", "@tabler/*"]
							},
							{
								"type": true,
								"source": ["@mantine/*", "@tabler/*"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["@*/**", "!@/**"]
							},
							{
								"type": true,
								"source": ["@*/**", "!@/**"]
							},
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["./*", "!./*.css"]
							},
							{
								"type": true,
								"source": ["./*", "!./*.css"]
							},
							{
								"source": ["./*.css"]
							},
							":BLANK_LINE:",
							{
								"type": false,
								"source": ["../*"]
							},
							{
								"type": true,
								"source": ["../*"]
							}
						]
					}
				}
			}
		}
	}
}
