{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check:types": "next typegen && tsc --noEmit",
    "deps:check": "node scripts/dependencyCheck.ts",
    "dev": "next dev",
    "dev:sign-in": "pnpm run \"/^(dev|sign-in)$/\"",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "seed": "tsx --env-file=.env.local seed/seed.ts",
    "sign-in": "tsx --env-file=.env.local seed/signInServer.ts",
    "start": "next start",
    "test": "sh -c 'vitest ${1:-src}' --",
    "test:agent": "sh -c 'vitest run ${1:-src} --coverage --coverage.include ${1:-src} --reporter=agent' --",
    "test:coverage": "vitest run --coverage src",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:trace": "sh -c 'pnpm test:e2e --trace on \"$@\"; playwright show-report' --"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.32"
    }
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.3",
    "@preact/signals": "2.11.3",
    "@schedule-x/calendar": "4.9.1",
    "@schedule-x/events-service": "4.9.1",
    "@schedule-x/react": "4.1.0",
    "@schedule-x/theme-default": "4.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.49.0",
    "better-auth": "1.7.11",
    "luxon": "3.7.2",
    "mongodb": "^7.7.0",
    "mongoose": "9.11.2",
    "next": "16.4.2",
    "preact": "10.29.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-screen-wake-lock": "3.1.1",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "temporal-polyfill": "0.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "28.0.1",
    "@types/luxon": "3.7.6",
    "@types/node": "24.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.2",
    "jsdom": "29.0.1",
    "lefthook": "2.2.2",
    "mongodb-memory-server": "11.3.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "5.2.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.14.0"
}
