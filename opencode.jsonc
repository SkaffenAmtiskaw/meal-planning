{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "biome": {
      "command": ["pnpm", "lint", "$FILE"]
    }
  },
  "default_agent": "implement",
  "subagent_depth": 2,
  "agent": {
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "edit": {
      "biome.json*": "ask",
      "vitest.config.ts": "ask"
    }
  }
}